@startuml
title Sequence Diagram - Pengajuan Izin / Sakit
actor "Orang Tua" as User
boundary "View Izin" as View
control "SuratIzinController" as Controller
entity "SuratIzinModel" as Model
database "Database" as DB

User -> View : Isi Form & Upload File Bukti
View -> Controller : store(form_data, file)
Controller -> Controller : Validate Input (rules)
alt Validasi Berhasil
    Controller -> Controller : Save File (Storage::put)
    Controller -> Model : create(data_izin)
    Model -> DB : INSERT INTO tbl_surat_izin (..., file_bukti, status='pending')
    DB --> Model : success
    Model --> Controller : Data Surat Izin
    Controller --> View : Redirect Back (Success)
    View --> User : Menampilkan Pesan Berhasil
else Validasi Gagal
    Controller --> View : Redirect Back (Errors)
    View --> User : Menampilkan Pesan Error
end
@enduml
