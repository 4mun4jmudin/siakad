@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor Administrator
actor Guru
actor Siswa
actor "Orang Tua" as Ortu

rectangle "Sistem Presensi Siswa (Validasi Haversine)" {
  
  ' Use Cases Global
  usecase "Login" as UC_Login
  usecase "Logout" as UC_Logout
  usecase "Dashboard" as UC_Dashboard

  ' --- USE CASE ADMINISTRATOR ---
  usecase "Kelola Data User" as A1
  usecase "Kelola Data Guru" as A2
  usecase "Kelola Data Siswa" as A3
  usecase "Kelola Data Orang Tua" as A4
  usecase "Kelola Data Kelas" as A5
  usecase "Kelola Data Lokasi Presensi" as A6
  usecase "Kelola Jadwal Presensi" as A7
  usecase "Monitoring Data Presensi" as A8
  
  ' --- USE CASE GURU ---
  usecase "Monitoring Presensi Siswa" as G1
  usecase "Lihat Detail Presensi" as G2
  usecase "Verifikasi Pengajuan Izin/Sakit" as G3
  
  ' --- USE CASE SISWA ---
  usecase "Presensi Masuk" as S1
  usecase "Presensi Pulang" as S2
  usecase "Lihat Riwayat Presensi" as S3
  
  ' Sub-Use Case Haversine (Include)
  usecase "Ambil Lokasi" as Sub1
  usecase "Validasi Lokasi Haversine" as Sub2
  usecase "Simpan Presensi" as Sub3

  S1 ..> Sub1 : <<include>>
  S1 ..> Sub2 : <<include>>
  S1 ..> Sub3 : <<include>>
  
  S2 ..> Sub1 : <<include>>
  S2 ..> Sub2 : <<include>>
  S2 ..> Sub3 : <<include>>
  
  ' --- USE CASE ORANG TUA ---
  usecase "Monitoring Kehadiran Anak" as O1
  usecase "Lihat Riwayat Presensi Anak" as O2
  usecase "Ajukan Izin/Sakit" as O3
}

' === RELASI ADMINISTRATOR ===
Administrator --> UC_Login
Administrator --> UC_Dashboard
Administrator --> A1
Administrator --> A2
Administrator --> A3
Administrator --> A4
Administrator --> A5
Administrator --> A6
Administrator --> A7
Administrator --> A8
Administrator --> UC_Logout

' === RELASI GURU ===
Guru --> UC_Login
Guru --> UC_Dashboard
Guru --> G1
Guru --> G2
Guru --> G3
Guru --> UC_Logout

' === RELASI SISWA ===
Siswa --> UC_Login
Siswa --> UC_Dashboard
Siswa --> S1
Siswa --> S2
Siswa --> S3
Siswa --> UC_Logout

' === RELASI ORANG TUA ===
Ortu --> UC_Login
Ortu --> UC_Dashboard
Ortu --> O1
Ortu --> O2
Ortu --> O3
Ortu --> UC_Logout

@enduml
