@startuml class_diagram_absensi
skinparam classAttributeIconSize 0
skinparam nodesep 80
skinparam ranksep 80

class User {
  - id_pengguna: int
  - nama_lengkap: string
  - peran: string
  ---
  + login()
  + logout()
  + update_profile()
}

class PengaturanAbsensi {
  - id_pengaturan: int
  - latitude_sekolah: string
  - longitude_sekolah: string
  - radius_toleransi: int
  - batas_akurasi_gps: int
  - jam_masuk: time
  - jam_pulang: time
  ---
  + get_pengaturan()
  + update_pengaturan()
}

class Siswa {
  - id_siswa: int
  - nis: string
  - id_kelas: int
  - id_pengguna: int
  ---
  + get_jadwal()
  + get_rekap_absensi()
  + ajukan_izin()
  + absen_mandiri()
}

class Guru {
  - id_guru: int
  - nip: string
  - id_pengguna: int
  ---
  + absen_hadir()
  + absen_pulang()
  + isi_jurnal_kelas()
}

class JadwalMengajar {
  - id_jadwal: int
  - id_guru: int
  - id_kelas: int
  - id_mapel: int
  - hari: string
  - waktu_mulai: time
  - waktu_selesai: time
  ---
  + insert_data()
  + update_data()
  + get_detail_jadwal()
}

class AbsensiGuru {
  - id_absensi: string
  - id_guru: int
  - tanggal: date
  - waktu_datang: time
  - waktu_pulang: time
  - status: string
  - koordinat_lokasi: string
  ---
  + insert_data()
  + update_data()
  + validasi_lokasi()
}

class AbsensiSiswa {
  - id_absensi: string
  - id_siswa: int
  - tanggal: date
  - waktu_masuk: time
  - waktu_pulang: time
  - status: string
  - keterangan: string
  ---
  + insert_data()
  + update_data()
}

class SiswaLiveLocation {
  - id_lokasi: string
  - id_siswa: int
  - tanggal: date
  - koordinat: string
  ---
  + insert_data()
  + get_lokasi()
}

class AbsensiSiswaMapel {
  - id_absensi_mapel: string
  - id_jadwal: int
  - id_siswa: int
  - tanggal: date
  - status: string
  ---
  + insert_data()
  + update_data()
}

class JurnalMengajar {
  - id_jurnal: string
  - id_jadwal: int
  - tanggal: date
  - materi_pembelajaran: text
  ---
  + insert_data()
  + update_data()
}

class SuratIzin {
  - id_surat: string
  - id_siswa: int
  - jenis_surat: string
  - tanggal_mulai: date
  - tanggal_selesai: date
  - keterangan: text
  - file_bukti: string
  - status_pengajuan: string
  - id_penyetuju: int
  ---
  + insert_data()
  + setujui_izin()
  + tolak_izin()
}

class AksesEditAbsensi {
  - id_akses: string
  - id_guru: int
  - tanggal_absensi: date
  - alasan: text
  - status_akses: string
  - batas_waktu_akses: datetime
  ---
  + ajukan_akses()
  + beri_izin()
  + tutup_akses()
}

class PengajuanGuruPengganti {
  - id_pengajuan: string
  - id_jadwal: int
  - tanggal: date
  - id_guru_peminta: int
  - id_guru_pengganti: int
  - status: string
  ---
  + ajukan_pengganti()
  + validasi_ketersediaan()
  + setujui_pengajuan()
}

class PengajuanGuruTarget {
  - id_target: string
  - id_pengajuan: string
  - id_guru: int
  - status_respon: string
  ---
  + insert_data()
  + terima_tawaran()
  + tolak_tawaran()
}

class OrangTuaWali {
  - id_ortu: int
  - id_siswa: int
  - id_pengguna: int
  ---
  + pantau_absensi()
}

' Konfigurasi tampilan garis dan layout
skinparam linetype ortho
skinparam roundcorner 10
skinparam nodesep 80
skinparam ranksep 100

' =========================================
' PENATAAN LAYOUT (GRID BERLAPIS)
' =========================================

' --- Baris 2: OrangTuaWali - User - Guru ---
together {
  class OrangTuaWali
  class User
  class Guru
}
OrangTuaWali -[hidden]right- User
User -[hidden]right- Guru

' --- Baris 3: Siswa - SuratIzin - Jadwal - Pengajuan - AbsensiGuru ---
together {
  class Siswa
  class SuratIzin
  class JadwalMengajar
  class PengajuanGuruPengganti
  class AbsensiGuru
}
Siswa -[hidden]right- SuratIzin
SuratIzin -[hidden]right- JadwalMengajar
JadwalMengajar -[hidden]right- PengajuanGuruPengganti
PengajuanGuruPengganti -[hidden]right- AbsensiGuru

' --- Baris 4: Pendukung Siswa & Guru di baris terbawah ---
together {
  class SiswaLiveLocation
  class AbsensiSiswa
  class AbsensiSiswaMapel
  class JurnalMengajar
  class PengajuanGuruTarget
  class AksesEditAbsensi
}
SiswaLiveLocation -[hidden]right- AbsensiSiswa
AbsensiSiswa -[hidden]right- AbsensiSiswaMapel
AbsensiSiswaMapel -[hidden]right- JurnalMengajar
JurnalMengajar -[hidden]right- PengajuanGuruTarget
PengajuanGuruTarget -[hidden]right- AksesEditAbsensi


' =========================================
' TARIKAN GARIS RELASI 
' =========================================

' Relasi dari Pengaturan
PengaturanAbsensi "1" -down- "1" User : " \n dikelola oleh " <

' Relasi Utama User (Agregasi)
User "1" o-left- "1" OrangTuaWali : " memiliki " >
User "1" o-right- "1" Guru : " memiliki " >
User "1" o-down- "1" Siswa : " \n memiliki " >

' Relasi Khusus User & OrangTua
User "1" -down- "*" SuratIzin : " \n menyetujui " >
OrangTuaWali "1" -down- "1..*" Siswa : " \n wali dari " >

' Relasi dari Siswa (ke bawah)
Siswa "1" *-right- "*" SuratIzin : " mengajukan " >
Siswa "1" *-down- "*" SiswaLiveLocation : " \n mencatat " >
Siswa "1" *-down- "*" AbsensiSiswa : " \n memiliki " >
Siswa "1" *-down- "*" AbsensiSiswaMapel : " \n memiliki " >

' Relasi dari Guru (ke bawah)
Guru "1" -down- "*" JadwalMengajar : " \n mengajar " >
Guru "1" *-down- "*" AbsensiGuru : " \n melakukan " >
Guru "1" -down- "*" PengajuanGuruPengganti : " \n meminta " >
Guru "1" -down- "*" AksesEditAbsensi : " \n mengajukan " >
Guru "1" -down- "*" PengajuanGuruTarget : " \n merespon tawaran " >

' Relasi dari JadwalMengajar (ke bawah & kanan)
JadwalMengajar "1" *-down- "*" JurnalMengajar : " \n memiliki " >
JadwalMengajar "1" *-down- "*" AbsensiSiswaMapel : " \n memiliki " >
JadwalMengajar "1" -right- "*" PengajuanGuruPengganti : " digantikan " >

' Relasi Pengajuan Guru Pengganti (ke bawah)
PengajuanGuruPengganti "1" *-down- "*" PengajuanGuruTarget : " \n memiliki target " >

